<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>de.atvantage.academy.javaupdate</groupId>
    <artifactId>ueberblick</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>ueberblick-werkzeuge</artifactId>
  <name>Überblick · Werkzeuge</name>
  <description>Lässt jdeps und jdeprscan des laufenden JDK über die übersetzten Klassen aller Bruch-Module laufen – und über eigene Klassen, die interne und abgekündigte APIs des JDK nutzen.</description>

  <!--
    Die Abhängigkeiten sorgen nur dafür, dass Maven die Bruch-Module vorher übersetzt.
    Dazu kommen eigene Klassen mit typischem Java-8-Code: Nummernkreis nutzt
    sun.misc.Unsafe, eine interne API des JDK (jdeps mit „jdk-internals“); Lagerbestand,
    Druckauftrag und Exportwaechter nutzen abgekündigte APIs (jdeprscan). Aufruf (oder Run Configuration gleichen Namens):

      mvn clean compile -pl ueberblick/werkzeuge -am -Pjdeps
      mvn clean compile -pl ueberblick/werkzeuge -am -Pjdeprscan

    Ohne Profil passiert nichts – auch nicht auf JDK 8, das jdeprscan nicht kennt.
  -->
  <dependencies>
    <dependency>
      <groupId>de.atvantage.academy.javaupdate</groupId>
      <artifactId>bauzeit-unterstrich</artifactId>
      <version>${project.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>de.atvantage.academy.javaupdate</groupId>
      <artifactId>bauzeit-eingeschraenkte-bezeichner</artifactId>
      <version>${project.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>de.atvantage.academy.javaupdate</groupId>
      <artifactId>laufzeit-jaxb</artifactId>
      <version>${project.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>de.atvantage.academy.javaupdate</groupId>
      <artifactId>laufzeit-reflection</artifactId>
      <version>${project.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>de.atvantage.academy.javaupdate</groupId>
      <artifactId>laufzeit-zeichensatz</artifactId>
      <version>${project.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>de.atvantage.academy.javaupdate</groupId>
      <artifactId>laufzeit-datumsformat</artifactId>
      <version>${project.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>de.atvantage.academy.javaupdate</groupId>
      <artifactId>laufzeit-zeitstempel</artifactId>
      <version>${project.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>de.atvantage.academy.javaupdate</groupId>
      <artifactId>bauzeit-sequenced</artifactId>
      <version>${project.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>de.atvantage.academy.javaupdate</groupId>
      <artifactId>laufzeit-security-manager</artifactId>
      <version>${project.version}</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <properties>
    <!-- Ziel-Release, gegen das jdeprscan prüft – hier hochstellen, um 25 zu prüfen. -->
    <werkzeuge.release>21</werkzeuge.release>
    <!--
      ÜBERSETZT MIT „source“ UND „target“ 8 STATT „release“ 8. Mit „release“ kennt javac nur die
      offizielle API von Java 8; sun.misc.Unsafe gehört nicht dazu, und die Klasse ließe
      sich gar nicht übersetzen. So, gegen das installierte JDK, bauen viele Altprojekte.
    -->
    <maven.compiler.release></maven.compiler.release>
    <maven.compiler.source>8</maven.compiler.source>
    <maven.compiler.target>8</maven.compiler.target>
  </properties>

  <profiles>
    <!-- jdeps: Welche Abhängigkeiten fehlen dem JDK, welche JDK-Interna werden genutzt? -->
    <profile>
      <id>jdeps</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>jdeps-missing-deps</id>
                <phase>compile</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <executable>${java.home}/bin/jdeps</executable>
                  <arguments>
                    <argument>--missing-deps</argument>
                    <argument>${project.build.outputDirectory}</argument>
                    <argument>${project.basedir}/../../inkompatibilitaeten/bauzeit/unterstrich/target/classes</argument>
                    <argument>${project.basedir}/../../inkompatibilitaeten/bauzeit/eingeschraenkte-bezeichner/target/classes</argument>
                    <argument>${project.basedir}/../../inkompatibilitaeten/laufzeit/jaxb/target/classes</argument>
                    <argument>${project.basedir}/../../inkompatibilitaeten/laufzeit/reflection/target/classes</argument>
                    <argument>${project.basedir}/../../inkompatibilitaeten/laufzeit/zeichensatz/target/classes</argument>
                    <argument>${project.basedir}/../../inkompatibilitaeten/laufzeit/datumsformat/target/classes</argument>
                    <argument>${project.basedir}/../../inkompatibilitaeten/laufzeit/zeitstempel/target/classes</argument>
                    <argument>${project.basedir}/../../inkompatibilitaeten/bauzeit/sequenced/target/classes</argument>
                    <argument>${project.basedir}/../../inkompatibilitaeten/laufzeit/security-manager/target/classes</argument>
                  </arguments>
                </configuration>
              </execution>
              <execution>
                <id>jdeps-jdk-internals</id>
                <phase>compile</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <executable>${java.home}/bin/jdeps</executable>
                  <arguments>
                    <argument>--jdk-internals</argument>
                    <argument>${project.build.outputDirectory}</argument>
                    <argument>${project.basedir}/../../inkompatibilitaeten/bauzeit/unterstrich/target/classes</argument>
                    <argument>${project.basedir}/../../inkompatibilitaeten/bauzeit/eingeschraenkte-bezeichner/target/classes</argument>
                    <argument>${project.basedir}/../../inkompatibilitaeten/laufzeit/jaxb/target/classes</argument>
                    <argument>${project.basedir}/../../inkompatibilitaeten/laufzeit/reflection/target/classes</argument>
                    <argument>${project.basedir}/../../inkompatibilitaeten/laufzeit/zeichensatz/target/classes</argument>
                    <argument>${project.basedir}/../../inkompatibilitaeten/laufzeit/datumsformat/target/classes</argument>
                    <argument>${project.basedir}/../../inkompatibilitaeten/laufzeit/zeitstempel/target/classes</argument>
                    <argument>${project.basedir}/../../inkompatibilitaeten/bauzeit/sequenced/target/classes</argument>
                    <argument>${project.basedir}/../../inkompatibilitaeten/laufzeit/security-manager/target/classes</argument>
                  </arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!-- jdeprscan: Welche abgekündigten APIs werden genutzt, und welche davon verschwinden? -->
    <profile>
      <id>jdeprscan</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>jdeprscan</id>
                <phase>compile</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <executable>${java.home}/bin/jdeprscan</executable>
                  <arguments>
                    <argument>--release</argument>
                    <argument>${werkzeuge.release}</argument>
                    <argument>--for-removal</argument>
                    <argument>${project.build.outputDirectory}</argument>
                    <argument>${project.basedir}/../../inkompatibilitaeten/bauzeit/unterstrich/target/classes</argument>
                    <argument>${project.basedir}/../../inkompatibilitaeten/bauzeit/eingeschraenkte-bezeichner/target/classes</argument>
                    <argument>${project.basedir}/../../inkompatibilitaeten/laufzeit/jaxb/target/classes</argument>
                    <argument>${project.basedir}/../../inkompatibilitaeten/laufzeit/reflection/target/classes</argument>
                    <argument>${project.basedir}/../../inkompatibilitaeten/laufzeit/zeichensatz/target/classes</argument>
                    <argument>${project.basedir}/../../inkompatibilitaeten/laufzeit/datumsformat/target/classes</argument>
                    <argument>${project.basedir}/../../inkompatibilitaeten/laufzeit/zeitstempel/target/classes</argument>
                    <argument>${project.basedir}/../../inkompatibilitaeten/bauzeit/sequenced/target/classes</argument>
                    <argument>${project.basedir}/../../inkompatibilitaeten/laufzeit/security-manager/target/classes</argument>
                  </arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
