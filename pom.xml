<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>de.atvantage.academy.javaupdate</groupId>
  <artifactId>java-update</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>Java-Update · Übungsprojekt</name>
  <description>Übungsprojekt der Schulung „Java-Update“: je Übung ein Modul, Startstand Java 8.</description>

  <modules>
    <module>ueberblick</module>
    <module>inkompatibilitaeten</module>
    <module>neuerungen</module>
    <module>schwerpunkte</module>
  </modules>

  <properties>
    <!--
      DER STARTSTAND IST JAVA 8. Jedes Übungsmodul setzt das Release noch einmal in
      seiner eigenen pom.xml – dort stellst Du es hoch, Modul für Modul, so wie bei einer
      echten Migration. Nach jedem Umstellen mit „clean“ bauen.
    -->
    <maven.compiler.release>8</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <junit.version>5.13.4</junit.version>
    <jackson.version>2.19.2</jackson.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>com.fasterxml.jackson</groupId>
        <artifactId>jackson-bom</artifactId>
        <version>${jackson.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>de.atvantage.academy.javaupdate</groupId>
        <artifactId>bestellung-domaene</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-clean-plugin</artifactId>
          <version>3.5.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.14.0</version>
          <configuration>
            <!-- Die Warnungen sind Teil des Lernstoffs: Sie kündigen die Brüche an. -->
            <showWarnings>true</showWarnings>
            <compilerArgs>
              <arg>-Xlint:all,-options,-serial,-processing</arg>
            </compilerArgs>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.5.3</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>3.4.2</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-resources-plugin</artifactId>
          <version>3.3.1</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-install-plugin</artifactId>
          <version>3.1.4</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-dependency-plugin</artifactId>
          <version>3.8.1</version>
        </plugin>
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>exec-maven-plugin</artifactId>
          <version>3.5.1</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-javadoc-plugin</artifactId>
          <version>3.11.2</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-toolchains-plugin</artifactId>
          <version>3.2.0</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

  <profiles>
    <!--
      DER STAND VORHER, MIT ECHTEM JDK 8 (optional): mvn clean verify -Pjdk8
      Mit dem Profil laufen die Tests auf einem JDK 8, übersetzt wird weiter mit Deinem
      JDK und dem Release des Moduls. Dann sind auch die Laufzeitbrüche grün, bevor Du
      etwas umstellst – mit JDK 21 oder 25 allein treten sie schon mit Release 8 auf.
      Voraussetzung: ein installiertes JDK 8, eingetragen in ~/.m2/toolchains.xml.
    -->
    <profile>
      <id>jdk8</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <configuration>
              <!-- Ein Bereich: JDK 8 steht in toolchains.xml mal als 1.8, mal als 8. -->
              <jdkToolchain>
                <version>[1.8,9)</version>
              </jdkToolchain>
            </configuration>
          </plugin>
          <!--
            Erst nach Übersetzen und Tests gilt JDK 8 für alles Weitere – für die Messung
            mit -Pmessen (exec:exec). Davor übersetzt weiter Dein JDK.
          -->
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-toolchains-plugin</artifactId>
            <executions>
              <execution>
                <id>jdk8-nach-den-tests</id>
                <phase>prepare-package</phase>
                <goals>
                  <goal>toolchain</goal>
                </goals>
                <configuration>
                  <toolchains>
                    <jdk>
                      <version>[1.8,9)</version>
                    </jdk>
                  </toolchains>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <!--
      EIN BESTIMMTES JDK 21 ODER 25: mvn clean verify -Pjdk21 bzw. -Pjdk25 (25 optional)
      Mit dem Profil laufen Übersetzen, Tests und Programme (exec:exec) auf diesem JDK
      statt auf dem, mit dem Maven läuft. Das Release des Moduls muss das JDK kennen –
      sonst auf der Kommandozeile überschreiben: -Dmaven.compiler.release=21
      Voraussetzung: das JDK, eingetragen in ~/.m2/toolchains.xml.
    -->
    <profile>
      <id>jdk21</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-toolchains-plugin</artifactId>
            <executions>
              <execution>
                <goals>
                  <goal>toolchain</goal>
                </goals>
                <configuration>
                  <toolchains>
                    <jdk>
                      <version>[21,22)</version>
                    </jdk>
                  </toolchains>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>jdk25</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-toolchains-plugin</artifactId>
            <executions>
              <execution>
                <goals>
                  <goal>toolchain</goal>
                </goals>
                <configuration>
                  <toolchains>
                    <jdk>
                      <version>[25,26)</version>
                    </jdk>
                  </toolchains>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
