<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>de.atvantage.academy.javaupdate</groupId>
    <artifactId>kompatibilitaet</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>kompatibilitaet-zeichensatz</artifactId>
  <name>Kompatibilität · Standard-Zeichensatz</name>

  <properties>
    <!-- Hier hochstellen. -->
    <maven.compiler.release>21</maven.compiler.release>
  </properties>

  <profiles>
    <!--
      DAS ALTSYSTEM LIEF AUF WINDOWS. Bis Java 17 übernahm die JVM den Standard-Zeichensatz
      vom Betriebssystem – auf einem deutschen Windows ist das windows-1252. Dieses Profil
      stellt das für JDKs bis 17 nach, damit der Test auch auf Linux und macOS so läuft wie
      damals auf dem Server. Ab Java 18 ist der Standard überall UTF-8 (JEP 400), egal
      was das Betriebssystem sagt – deshalb greift das Profil dort bewusst nicht.
      Wer selbst unter Windows arbeitet, sieht den Bruch auch ohne dieses Profil.
    -->
    <profile>
      <id>altsystem-windows</id>
      <activation>
        <jdk>[1.8,18)</jdk>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <configuration>
              <argLine>-Dfile.encoding=windows-1252</argLine>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
