<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>de.atvantage.academy.javaupdate</groupId>
    <artifactId>neuerungen-syntax</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>syntax-kompakte-quelldateien</artifactId>
  <name>Syntax · Kompakte Quelldateien</name>

  <properties>
    <!-- Hier hochstellen. -->
    <maven.compiler.release>25</maven.compiler.release>
  </properties>

  <!--
    DAS WERKZEUG STARTEN: mvn clean compile -pl neuerungen/syntax/kompakte-quelldateien -am -Pstart
    (oder Run Configuration syntax-kompakte-quelldateien-start). Nach dem Übersetzen startet
    Maven Lagerliste mit dem java des laufenden JDK – die Ausgabe steht in der Konsole.
    Ohne Profil passiert nichts.
  -->
  <profiles>
    <profile>
      <id>start</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>lagerliste</id>
                <phase>compile</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <executable>${java.home}/bin/java</executable>
                  <arguments>
                    <argument>-cp</argument>
                    <argument>${project.build.outputDirectory}</argument>
                    <argument>Lagerliste</argument>
                  </arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
