<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>de.atvantage.academy.javaupdate</groupId>
    <artifactId>schwerpunkte-modulsystem</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>modulsystem-anwendung</artifactId>
  <name>Modulsystem · Anwendung</name>

  <dependencies>
    <dependency>
      <groupId>de.atvantage.academy.javaupdate</groupId>
      <artifactId>modulsystem-modell</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- Das CSV-Format kennt die Anwendung nicht: Sie findet es erst zur Laufzeit. -->
    <dependency>
      <groupId>de.atvantage.academy.javaupdate</groupId>
      <artifactId>modulsystem-csv</artifactId>
      <version>${project.version}</version>
      <scope>runtime</scope>
    </dependency>
  </dependencies>

  <profiles>
    <!--
      Die Profile starten die Befehle der Übung nach dem Bau; die Anwendung wird zuletzt
      gebaut, dann liegen alle drei JARs in target/module. Aufruf jeweils mit
      mvn clean verify -f schwerpunkte/modulsystem/pom.xml -P«profil»
    -->
    <!--
      Startet die Anwendung auf dem Klassenpfad.
    -->
    <profile>
      <id>klassenpfad</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>exportlauf</id>
                <phase>verify</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <executable>${java.home}/bin/java</executable>
                  <arguments>
                    <argument>-cp</argument>
                    <argument>${project.basedir}/../target/module/*</argument>
                    <argument>bestellwesen.anwendung.Exportlauf</argument>
                  </arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <!--
      Startet die Anwendung auf dem Modulpfad, solange die JARs noch keine module-info
      haben: als automatisches Modul modulsystem.anwendung.
    -->
    <profile>
      <id>modulpfad-automatisch</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>exportlauf</id>
                <phase>verify</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <executable>${java.home}/bin/java</executable>
                  <arguments>
                    <argument>--module-path=${project.basedir}/../target/module</argument>
                    <argument>--module</argument>
                    <argument>modulsystem.anwendung/bestellwesen.anwendung.Exportlauf</argument>
                  </arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <!--
      Beschreibt das Modul der Anwendung mit dem Werkzeug jar.
    -->
    <profile>
      <id>beschreiben</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>beschreiben</id>
                <phase>verify</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <executable>${java.home}/bin/jar</executable>
                  <arguments>
                    <argument>--describe-module</argument>
                    <argument>--file</argument>
                    <argument>${project.basedir}/../target/module/${project.build.finalName}.jar</argument>
                  </arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <!--
      Startet die Anwendung auf dem Modulpfad unter ihrem eigenen Modulnamen
      bestellwesen.anwendung.
    -->
    <profile>
      <id>modulpfad</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>exportlauf</id>
                <phase>verify</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <executable>${java.home}/bin/java</executable>
                  <arguments>
                    <argument>--module-path=${project.basedir}/../target/module</argument>
                    <argument>--module</argument>
                    <argument>bestellwesen.anwendung/bestellwesen.anwendung.Exportlauf</argument>
                  </arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <!--
      Baut mit jlink das Image target/bild, listet seine Module und startet es über das Startskript
      (unter Windows exportlauf.bat).
    -->
    <profile>
      <id>image</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>jlink</id>
                <phase>verify</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <executable>${java.home}/bin/jlink</executable>
                  <arguments>
                    <argument>--module-path=${project.basedir}/../target/module</argument>
                    <argument>--add-modules</argument>
                    <argument>bestellwesen.anwendung</argument>
                    <argument>--strip-debug</argument>
                    <argument>--no-header-files</argument>
                    <argument>--no-man-pages</argument>
                    <argument>--launcher</argument>
                    <argument>exportlauf=bestellwesen.anwendung/bestellwesen.anwendung.Exportlauf</argument>
                    <argument>--output</argument>
                    <argument>${project.basedir}/../target/bild</argument>
                  </arguments>
                </configuration>
              </execution>
              <execution>
                <id>module</id>
                <phase>verify</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <executable>${project.basedir}/../target/bild/bin/java</executable>
                  <arguments>
                    <argument>--list-modules</argument>
                  </arguments>
                </configuration>
              </execution>
              <execution>
                <id>exportlauf</id>
                <phase>verify</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <executable>${project.basedir}/../target/bild/bin/exportlauf</executable>
                  <arguments />
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <!--
      Baut mit jlink das Image target/bild-mit-csv samt CSV-Format und startet es über das
      Startskript. Baut vorher auch target/bild, damit Du die Größe beider vergleichen kannst.
    -->
    <profile>
      <id>image-mit-csv</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>jlink-ohne-csv</id>
                <phase>verify</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <executable>${java.home}/bin/jlink</executable>
                  <arguments>
                    <argument>--module-path=${project.basedir}/../target/module</argument>
                    <argument>--add-modules</argument>
                    <argument>bestellwesen.anwendung</argument>
                    <argument>--strip-debug</argument>
                    <argument>--no-header-files</argument>
                    <argument>--no-man-pages</argument>
                    <argument>--launcher</argument>
                    <argument>exportlauf=bestellwesen.anwendung/bestellwesen.anwendung.Exportlauf</argument>
                    <argument>--output</argument>
                    <argument>${project.basedir}/../target/bild</argument>
                  </arguments>
                </configuration>
              </execution>
              <execution>
                <id>jlink</id>
                <phase>verify</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <executable>${java.home}/bin/jlink</executable>
                  <arguments>
                    <argument>--module-path=${project.basedir}/../target/module</argument>
                    <argument>--add-modules</argument>
                    <argument>bestellwesen.anwendung,bestellwesen.csv</argument>
                    <argument>--strip-debug</argument>
                    <argument>--no-header-files</argument>
                    <argument>--no-man-pages</argument>
                    <argument>--launcher</argument>
                    <argument>exportlauf=bestellwesen.anwendung/bestellwesen.anwendung.Exportlauf</argument>
                    <argument>--output</argument>
                    <argument>${project.basedir}/../target/bild-mit-csv</argument>
                  </arguments>
                </configuration>
              </execution>
              <execution>
                <id>exportlauf</id>
                <phase>verify</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <executable>${project.basedir}/../target/bild-mit-csv/bin/exportlauf</executable>
                  <arguments />
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
