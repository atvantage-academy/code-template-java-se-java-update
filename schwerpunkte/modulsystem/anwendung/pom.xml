<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>de.atvantage.academy.javaupdate</groupId>
    <artifactId>schwerpunkte-modulsystem</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>modulsystem-anwendung</artifactId>
  <name>Modulsystem · Anwendung</name>

  <dependencies>
    <dependency>
      <groupId>de.atvantage.academy.javaupdate</groupId>
      <artifactId>modulsystem-modell</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- Das CSV-Format kennt die Anwendung nicht: Sie findet es erst zur Laufzeit. -->
    <dependency>
      <groupId>de.atvantage.academy.javaupdate</groupId>
      <artifactId>modulsystem-csv</artifactId>
      <version>${project.version}</version>
      <scope>runtime</scope>
    </dependency>
  </dependencies>

  <profiles>
    <!--
      Startet die Anwendung auf dem Klassenpfad: mvn clean verify -f schwerpunkte/modulsystem/pom.xml -Pklassenpfad
      Gleichwertig zu java -cp "schwerpunkte/modulsystem/target/module/*" bestellwesen.anwendung.Exportlauf
      Die Anwendung wird zuletzt gebaut; dann liegen alle drei JARs in target/module.
    -->
    <profile>
      <id>klassenpfad</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>exportlauf</id>
                <phase>verify</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <executable>${java.home}/bin/java</executable>
                  <arguments>
                    <argument>-cp</argument>
                    <argument>${project.basedir}/../target/module/*</argument>
                    <argument>bestellwesen.anwendung.Exportlauf</argument>
                  </arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
