<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>de.atvantage.academy.javaupdate</groupId>
    <artifactId>schwerpunkte</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>schwerpunkte-virtual-threads</artifactId>
  <packaging>pom</packaging>
  <name>Schwerpunkt · Virtual Threads</name>
  <description>Die Bestellabwicklung auf Java 8: Domäne, REST-Schnittstelle in Schichten, Batch-Import.</description>

  <properties>
    <!-- Hier hochstellen – für Domäne, REST-Schnittstelle und Batch-Import zusammen. -->
    <maven.compiler.release>21</maven.compiler.release>
  </properties>

  <modules>
    <module>bestellung-domaene</module>
    <module>bestellung-rest</module>
    <module>bestellung-batch</module>
  </modules>

  <profiles>
    <!--
      MESSEN: mvn clean package -pl schwerpunkte/virtual-threads/bestellung-batch -am -Pjdk21,messen
      Nach dem Bauen startet exec:exec die Messung des Moduls (messen.mainClass) – in
      einer eigenen JVM, auf dem JDK aus -Pjdk8, -Pjdk21 oder -Pjdk25. Mit -am baut
      Maven die Domäne mit; ein mvn install vorher ist nicht nötig.
    -->
    <profile>
      <id>messen</id>
      <build>
        <pluginManagement>
          <plugins>
            <plugin>
              <!-- Läuft nur in den Modulen, die das Plugin nutzen: Batch-Import und REST-Schnittstelle. -->
              <groupId>org.codehaus.mojo</groupId>
              <artifactId>exec-maven-plugin</artifactId>
              <executions>
                <execution>
                  <id>messen</id>
                  <phase>package</phase>
                  <goals>
                    <goal>exec</goal>
                  </goals>
                  <configuration>
                    <executable>java</executable>
                    <arguments>
                      <argument>-classpath</argument>
                      <classpath/>
                      <argument>${messen.mainClass}</argument>
                    </arguments>
                  </configuration>
                </execution>
              </executions>
            </plugin>
          </plugins>
        </pluginManagement>
      </build>
    </profile>
  </profiles>
</project>
