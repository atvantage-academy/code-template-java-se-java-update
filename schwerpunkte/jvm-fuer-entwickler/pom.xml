                </goals>
                <configuration>
                  <executable>${java.home}/bin/java</executable>
                  <arguments>
                    <argument>-XX:ActiveProcessorCount=1</argument>
                    <argument>-XX:MaxRAM=1g</argument>
                    <argument>-Xlog:gc,gc+init</argument>
                    <argument>-version</argument>
                  </arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
