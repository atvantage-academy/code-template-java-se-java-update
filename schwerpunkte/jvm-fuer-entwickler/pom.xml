                <phase>validate</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <executable>${java.home}/bin/java</executable>
                  <arguments>
                    <argument>-XX:+UseG1GC</argument>
                    <argument>-Xmx1g</argument>
                    <argument>-XX:StartFlightRecording=filename=gc.jfr</argument>
                    <argument>Speicherlast.java</argument>
                  </arguments>
                </configuration>
              </execution>
              <execution>
                <id>jfr-2</id>
                <phase>validate</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <executable>${java.home}/bin/jfr</executable>
