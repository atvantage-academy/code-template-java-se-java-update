  <artifactId>schwerpunkte-jvm-fuer-entwickler</artifactId>
  <name>Schwerpunkt · Die JVM für Entwickler:innen</name>
  <description>
    Die REST-Schnittstelle der Bestellabwicklung als startbares JAR und zwei Programme,
    die direkt aus dem Quelltext starten (Speicherlast.java, Angeheftet.java). Die Übung
    ändert keinen Code, sie startet die JVM mit anderen Optionen.
  </description>

  <properties>
    <!-- Das JAR, das „package“ baut; der Lasttest darin startet die REST-Schnittstelle. -->
    <lasttest.klassenpfad>target/jvm-fuer-entwickler.jar</lasttest.klassenpfad>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
  </dependencies>

  <build>
    <!--
      STARTBAR OHNE MAVEN: „package“ legt das JAR als target/jvm-fuer-entwickler.jar ab und
      die Abhängigkeiten daneben nach target/lib; das Manifest nennt den Klassenpfad. Der
      AOT-Cache braucht ein JAR – mit einem Ordner voller Klassen geht er nicht.
    -->
    <finalName>jvm-fuer-entwickler</finalName>
    <pluginManagement>
      <plugins>
        <!--
          Alle Befehle laufen in diesem Ordner – wie auf der Kommandozeile nach
          „cd schwerpunkte/jvm-fuer-entwickler“. Hier landen auch die Aufzeichnungen
          (*.jfr), der AOT-Cache und das CDS-Archiv. java und jfr kommen aus dem JDK, mit
          dem Maven läuft.
        -->
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>exec-maven-plugin</artifactId>
          <configuration>
            <workingDirectory>${project.basedir}</workingDirectory>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <manifest>
              <mainClass>bestellung.rest.RestAnwendung</mainClass>
              <addClasspath>true</addClasspath>
              <classpathPrefix>lib/</classpathPrefix>
            </manifest>
          </archive>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>abhaengigkeiten-kopieren</id>
            <phase>package</phase>
            <goals>
              <goal>copy-dependencies</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.directory}/lib</outputDirectory>
              <includeScope>runtime</includeScope>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      Die Profile führen je einen Befehl der Übung aus, manche mit der Auswertung
      dahinter. Sie laufen schon in „validate“ und bauen nichts: Ein neu gebautes JAR
      passte nicht mehr zum AOT-Cache. Aufruf jeweils mit
      mvn validate -f schwerpunkte/jvm-fuer-entwickler/pom.xml -P«profil»
      Die Profile zum Lasttest brauchen das gebaute JAR (mvn clean verify -f …).
    -->
    <!--
      Was die JVM auf diesem Rechner wählt.
    -->
    <profile>
      <id>ergonomie</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>java</id>
                <phase>validate</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <executable>${java.home}/bin/java</executable>
                  <arguments>
                    <argument>-Xlog:gc,gc+init</argument>
                    <argument>-version</argument>
                  </arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
