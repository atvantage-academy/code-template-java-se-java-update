<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>de.atvantage.academy.javaupdate</groupId>
    <artifactId>inkompatibilitaeten-laufzeit</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>laufzeit-jaxb</artifactId>
  <name>Laufzeit · JAXB</name>

  <properties>
    <!-- Hier hochstellen. -->
    <maven.compiler.release>21</maven.compiler.release>
  </properties>

  <!--
    JAXB IST SEIT JAVA 11 NICHT MEHR IM JDK (JEP 320). Es kommt jetzt als Abhängigkeit –
    als Jakarta XML Binding mit dem Namensraum jakarta.xml.bind. Der Namensraum ist keine
    Änderung des JDK, sondern der Wechsel der Spezifikation zur Eclipse Foundation.
    Auf einem Jakarta-EE-Server bringt der Server beides mit: dort scope „provided“.
  -->
  <dependencies>
    <dependency>
      <groupId>jakarta.xml.bind</groupId>
      <artifactId>jakarta.xml.bind-api</artifactId>
      <version>4.0.5</version>
    </dependency>
    <dependency>
      <groupId>org.glassfish.jaxb</groupId>
      <artifactId>jaxb-runtime</artifactId>
      <version>4.0.9</version>
      <scope>runtime</scope>
    </dependency>
  </dependencies>
</project>
